+def _native_query(statement: str, dialect: str) -> bool:
+    """Native DML/DDL errors cannot prove trigger/sequence outcomes from a code alone."""
+    try:
+        policy = check_statement(statement, dialect, trial_mode=True)
+        root = sqlglot.parse_one(statement, read=dialect)
+        return (policy.read_only and isinstance(root, (exp.Select, exp.SetOperation))
+                and not sequence_read(statement, dialect)
+                and not any(isinstance(node, exp.Lock) for node in root.walk())
+                and not any(isinstance(node, exp.Var) and node.name.upper() in {"UPDLOCK", "XLOCK"}
+                            for hint in root.find_all(exp.WithTableHint) for node in hint.walk()))
+    except ValueError:
+        return False
+
+
+def _oracle_code(original: object) -> int | None:
+    if not isinstance(original, oracledb.DatabaseError) or not original.args:
+        return None
+    detail = original.args[0]
+    code = getattr(detail, "code", None)
+    if (isinstance(code, int) and not isinstance(code, bool)
+            and getattr(detail, "full_code", None) == f"ORA-{code:05d}"):
+        return code
+    return None
+
+
