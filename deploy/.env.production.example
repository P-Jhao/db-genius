# Copy to .env.production beside deploy-on-server.sh; chmod 600 .env.production.
# Replace every REPLACE_* value. Generate independent passwords: openssl rand -hex 24
# deploy-on-server.sh exports the full 40-character commit SHA; no mutable latest tag.
# For manual Compose operations, export SQLCHAT_IMAGE_TAG=<deployed commit SHA>.
SQLCHAT_HTTP_PORT=18109

POSTGRES_DB=sqlchat
POSTGRES_USER=sqlchat
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
RABBITMQ_DEFAULT_USER=sqlchat
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RANDOM_RABBITMQ_PASSWORD

# Exactly 32 ASCII characters (32 UTF-8 bytes): openssl rand -hex 16
# Keep the original key for upgrades; restore it with matching database backups.
SQLCHAT_ENCRYPT_KEY=REPLACE_WITH_32_RANDOM_CHARACTERS
SQLCHAT_BOOTSTRAP_USERNAME=admin
SQLCHAT_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
# Bootstrap creates a missing account; changing this value does not reset an existing account.

SQLCHAT_DEFAULT_MODEL_API_KEY=
SQLCHAT_DEFAULT_MODEL_BASE_URL=https://api.deepseek.com
SQLCHAT_DEFAULT_MODEL_NAME=deepseek-flash
# Optional positive token count; empty uses the model registry.
SQLCHAT_DEFAULT_MODEL_CONTEXT_WINDOW=
SQLCHAT_MODEL_CHAT_JSON_CAPABILITIES=[]

# Production OSS settings are operator supplied; no bucket or credential is shipped.
SQLCHAT_STORAGE_BACKEND=oss
SQLCHAT_STORAGE_ROOT=/app/uploads
SQLCHAT_OSS_ENDPOINT=
SQLCHAT_OSS_BUCKET=
SQLCHAT_OSS_ACCESS_KEY_ID=
SQLCHAT_OSS_ACCESS_KEY_SECRET=

# OCR uses separate credentials. Keep disabled until service access is configured.
SQLCHAT_OCR_ENABLED=false
SQLCHAT_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
SQLCHAT_OCR_ACCESS_KEY_ID=
SQLCHAT_OCR_ACCESS_KEY_SECRET=

SQLCHAT_TRIAL_ENABLED=false
# For the bundled low-memory demo: true + host trial-mysql + username sqlchat_demo.
# Generate independent hex passwords: openssl rand -hex 24 (one for each password).
# Only required for the local demo; leave blank when trial is off or using external MySQL.
SQLCHAT_TRIAL_MYSQL_ROOT_PASSWORD=
SQLCHAT_TRIAL_BUILTIN_DB_NAME=db-genius
SQLCHAT_TRIAL_BUILTIN_HOST=trial-mysql
SQLCHAT_TRIAL_BUILTIN_PORT=3306
SQLCHAT_TRIAL_BUILTIN_USERNAME=sqlchat_demo
SQLCHAT_TRIAL_BUILTIN_PASSWORD=

# Optional operator tuning; Compose retains application defaults when omitted.
SQLCHAT_CONTEXT_AUTO_COMPRESS_ENABLED=false
SQLCHAT_CONTEXT_AUTO_COMPRESS_THRESHOLD=0.8
SQLCHAT_CONTEXT_KEEP_LAST_MESSAGES=6
SQLCHAT_OBSERVATION_ELISION_ENABLED=true
SQLCHAT_STEP_SUMMARY_ENABLED=true
SQLCHAT_TOOL_OUTPUT_PER_TOOL_MAX_CHARACTERS=
SQLCHAT_SSE_KEEPALIVE_SECONDS=15
SQLCHAT_OTLP_ENDPOINT=
SQLCHAT_OTLP_SAMPLE_RATE=0.1
