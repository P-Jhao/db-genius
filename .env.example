# Replace every REPLACE_* value before starting. These are placeholders, not usable secrets.
# The backend deploy wrapper percent-encodes raw database and RabbitMQ credentials in memory.
POSTGRES_DB=sqlchat
POSTGRES_USER=sqlchat
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
RABBITMQ_DEFAULT_USER=sqlchat
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RABBITMQ_PASSWORD

# Exactly 32 UTF-8 bytes; generate with: python -c "import secrets; print(secrets.token_hex(16))"
SQLCHAT_ENCRYPT_KEY=REPLACE_WITH_32_RANDOM_CHARACTERS
SQLCHAT_BOOTSTRAP_USERNAME=admin
SQLCHAT_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD
SQLCHAT_DEFAULT_MODEL_API_KEY=
SQLCHAT_DEFAULT_MODEL_BASE_URL=https://api.deepseek.com
SQLCHAT_DEFAULT_MODEL_NAME=deepseek-flash
# Optional positive integer in tokens; empty uses the model registry. System default model only.
SQLCHAT_DEFAULT_MODEL_CONTEXT_WINDOW=
# Server-only exact completion endpoint/model allowlist; [] leaves the capability off.
SQLCHAT_MODEL_CHAT_JSON_CAPABILITIES=[]
# Explicit opt-in example (final URL must match exactly; use the corresponding /v1 model base URL):
# SQLCHAT_MODEL_CHAT_JSON_CAPABILITIES='[{"endpoint":"https://api.deepseek.com/v1/chat/completions","model":"deepseek-flash","capability":"chat_json_object"}]'
# File storage: use oss in production; set local explicitly for development/test.
SQLCHAT_STORAGE_BACKEND=oss
SQLCHAT_STORAGE_ROOT=/app/uploads
SQLCHAT_OSS_ENDPOINT=
SQLCHAT_OSS_BUCKET=
SQLCHAT_OSS_ACCESS_KEY_ID=
SQLCHAT_OSS_ACCESS_KEY_SECRET=

# OCR has a separate credential group. Enable only after configuring service access.
SQLCHAT_OCR_ENABLED=false
SQLCHAT_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
SQLCHAT_OCR_ACCESS_KEY_ID=
SQLCHAT_OCR_ACCESS_KEY_SECRET=

# Trial mode uses its dedicated built-in MySQL database and disables writes.
SQLCHAT_TRIAL_ENABLED=false
SQLCHAT_TRIAL_BUILTIN_DB_NAME=db-genius
SQLCHAT_TRIAL_BUILTIN_HOST=
SQLCHAT_TRIAL_BUILTIN_PORT=3306
SQLCHAT_TRIAL_BUILTIN_USERNAME=
SQLCHAT_TRIAL_BUILTIN_PASSWORD=

# Session, database and workflow limits.
SQLCHAT_SESSION_LIFETIME_SECONDS=86400
SQLCHAT_SESSION_IDLE_SECONDS=3600
SQLCHAT_QUERY_TIMEOUT_SECONDS=30
SQLCHAT_QUERY_MAX_ROWS=100
SQLCHAT_VERIFICATION_TIMEOUT_SECONDS=180
SQLCHAT_SQL_AGENT_MAX_STEPS=10
SQLCHAT_WORKFLOW_AGENT_MAX_STEPS=20
SQLCHAT_COMPARE_AGENT_MAX_STEPS=15

# Cross-turn compression and per-run context governance.
SQLCHAT_CONTEXT_AUTO_COMPRESS_ENABLED=false
SQLCHAT_CONTEXT_AUTO_COMPRESS_THRESHOLD=0.8
SQLCHAT_CONTEXT_KEEP_LAST_MESSAGES=6
SQLCHAT_OBSERVATION_ELISION_ENABLED=true
SQLCHAT_OBSERVATION_ELISION_THRESHOLD=0.6
SQLCHAT_OBSERVATION_ELISION_KEEP_LAST_STEPS=3
SQLCHAT_STEP_SUMMARY_ENABLED=true
SQLCHAT_STEP_SUMMARY_THRESHOLD=0.8
SQLCHAT_STEP_SUMMARY_KEEP_LAST_STEPS=4
SQLCHAT_STALE_REASONING_DISCARD_ENABLED=false
SQLCHAT_REPEATED_TOOL_CALL_WARNING_COUNT=3
SQLCHAT_REPEATED_TOOL_CALL_STOP_COUNT=5
SQLCHAT_TOOL_OUTPUT_MAX_CHARACTERS=4000
SQLCHAT_TOOL_OUTPUT_MAX_ROWS=50
# Optional: executeSql=1000,readFile=5000 or {"executeSql":1000,"readFile":5000}
SQLCHAT_TOOL_OUTPUT_PER_TOOL_MAX_CHARACTERS=
SQLCHAT_TOOL_ARTIFACT_TTL_SECONDS=1800
SQLCHAT_TOOL_ARTIFACT_MAX_PER_TASK=20

# Health probes and SSE heartbeat.
SQLCHAT_READY_BROKER_TIMEOUT_SECONDS=2
SQLCHAT_READY_DATABASE_TIMEOUT_SECONDS=3
SQLCHAT_SSE_KEEPALIVE_SECONDS=15
SQLCHAT_OTLP_ENDPOINT=
SQLCHAT_OTLP_SAMPLE_RATE=0.1
SQLCHAT_HTTP_PORT=8109
VITE_GITHUB_REPO=https://github.com/spcodhu/db-genius
